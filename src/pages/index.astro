---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/ui/SectionContainer.astro";
import GitHub from "../icons/social/GitHub.astro";
import LinkedIn from "../icons/social/LinkedIn.astro";
import Instagram from "../icons/social/Instagram.astro";
import Gmail from "../icons/social/Gmail.astro";
import Timeline from "../components/Timeline.astro";
import Skills from "../components/Skills.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import SchoolIcon from "../icons/School.astro";
import CodeIcon from "../icons/Code.astro";
import AboutUserIcon from "../icons/AboutUser.astro";
import BladesIcon from "../icons/Blades.astro";
import ThemedButton from "../components/ui/ThemedButton.astro";
import WhatsApp from "../icons/social/WhatsApp.astro";
---

<Layout>
  <main class="overflow-hidden">
    <!-- HERO -->
    <SectionContainer class="pt-28 lg:pt-36 pb-6">
      <div class="relative grid lg:grid-cols-[0.62fr_1.38fr] gap-6 lg:gap-6 items-center">
        <!-- Izquierda: texto (en desktop será derecha) -->
        <div class="reveal is-visible lg:order-2 lg:pl-6">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 px-3 py-1.5 text-xs text-white/70 mb-5">
            <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Disponible para nuevos proyectos
          </div>
          <h1 class="text-white text-[2.1rem] md:text-5xl lg:text-[3.3rem] font-bold leading-[0.95] tracking-[-0.03em]">
            Soy
            <span class="bg-gradient-to-r from-accent-blue via-accent-blue-strong to-accent-yellow bg-clip-text text-transparent"> Anthony Miranda</span>
          </h1>
          <h2 class="mt-4 text-lg lg:text-[1.35rem] leading-relaxed text-white/80 max-w-[43ch] font-light">
            <span class="text-white font-medium">Ingeniero en Sistemas.</span>{" "}
            <span class="text-accent-yellow/90">Desarrollador Web/Mobile FullStack.</span>{" "}
            <span class="text-accent-blue/90">De Santa Rosa de Copán, Honduras.</span>
          </h2>
          <!-- Bento simétrico redes -->
          <div class="mt-7 grid grid-cols-6 lg:grid-cols-12 gap-2.5">
            <div class="col-span-2 lg:col-span-4">
              <ThemedButton href="https://github.com/AnthonyEMF" variant="glass" class="w-full !px-3 sm:!px-5" aria-label="GitHub">
                <GitHub class="size-4" /> GitHub
              </ThemedButton>
            </div>
            <div class="col-span-2 lg:col-span-4">
              <ThemedButton href="https://www.linkedin.com/in/anthony-miranda-8a140b362/" variant="glass" class="w-full !px-3 sm:!px-5" aria-label="LinkedIn">
                <LinkedIn class="size-4" /> LinkedIn
              </ThemedButton>
            </div>
            <div class="col-span-2 lg:col-span-4">
              <ThemedButton href="mailto:anthony07miranda@gmail.com" variant="glass" class="w-full !px-3 sm:!px-5" aria-label="Gmail">
                <Gmail class="size-4" /> Gmail
              </ThemedButton>
            </div>
            <div class="col-span-3 lg:col-span-6">
              <ThemedButton href="https://wa.me/50497354899" variant="glass" class="w-full !px-3 sm:!px-5" aria-label="WhatsApp">
                <WhatsApp class="size-4" /> WhatsApp
              </ThemedButton>
            </div>
            <div class="col-span-3 lg:col-span-6">
              <ThemedButton href="https://www.instagram.com/anthony.emf/" variant="glass" class="w-full !px-3 sm:!px-5" aria-label="Instagram">
                <Instagram class="size-4" /> Instagram
              </ThemedButton>
            </div>
          </div>
        </div>

        <!-- Derecha: foto + stats glass (en desktop será izquierda) -->
        <div class="relative lg:order-1 lg:pr-2 reveal is-visible" style="transition-delay:120ms">
          <div class="relative mx-auto max-w-[220px] lg:max-w-[260px]">
            <div class="absolute -inset-1.5 bg-gradient-to-br from-accent-blue/14 via-transparent to-accent-yellow/14 rounded-[20px] blur-xl"></div>
            <div class="relative glass rounded-[18px] p-2 shadow-glass">
              <img
                id="gh-avatar"
                class="rounded-[14px] w-full aspect-[4/4.6] object-cover"
                src="/images/profile-photo.webp"
                alt="Anthony Miranda"
                width="260"
                height="299"
                loading="eager"
                decoding="async"
                onerror="this.onerror=null;this.src='/images/profile-photo.webp'"
              />
              <div class="absolute -bottom-3 -left-3 glass rounded-xl px-3 py-2 flex items-center gap-2.5 shadow-glass">
                <div class="size-8 rounded-full bg-gradient-to-br from-accent-blue to-accent-yellow grid place-items-center text-black font-bold text-sm">✓</div>
                <div>
                  <div class="text-white text-xs font-semibold leading-none">+4 proyectos</div>
                  <div class="text-white/60 text-[11px]">Producción real</div>
                </div>
              </div>
              <div class="absolute -top-2 -right-2 hidden lg:flex glass-strong rounded-full px-2.5 py-1 items-center gap-1.5 text-[11px] font-medium text-white shadow-glass">
                <span class="size-1.5 rounded-full bg-accent-yellow animate-pulse"></span> Enfocado en innovar
              </div>
            </div>
          </div>
          <div class="mt-6 grid grid-cols-3 gap-2">
            <div class="glass rounded-xl p-3 text-center">
              <div class="text-white text-base font-bold">2+</div>
              <div class="text-white/60 text-[11px]">Años exp.</div>
            </div>
            <div class="glass rounded-xl p-3 text-center">
              <div class="text-white text-base font-bold">20+</div>
              <div class="text-white/60 text-[11px]">Techs</div>
            </div>
            <div class="glass rounded-xl p-3 text-center bg-gradient-to-br from-accent-blue/14 to-accent-yellow/14 border-white/20">
              <div class="text-white text-base font-bold">100%</div>
              <div class="text-white/70 text-[11px]">Compromiso</div>
            </div>
          </div>
        </div>
      </div>
    </SectionContainer>

    <!-- Sobre mi -->
    <SectionContainer id="about" class="pt-16 lg:pt-20">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-white text-[1.7rem] lg:text-3xl font-semibold flex items-center gap-3">
          <span class="size-9 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 text-white grid place-items-center"><AboutUserIcon class="size-5" /></span>
          Sobre mí
        </h2>
        <span class="hidden md:inline text-white/40 text-sm tracking-widest uppercase">01 — Perfil</span>
      </div>
      <About />
    </SectionContainer>

    <!-- Formación -->
    <SectionContainer id="timeline" class="pt-16 lg:pt-20">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-white text-[1.7rem] lg:text-3xl font-semibold flex items-center gap-3">
          <span class="size-9 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 text-white grid place-items-center"><SchoolIcon class="size-5" /></span>
          Formación
        </h2>
        <span class="hidden md:inline text-white/40 text-sm tracking-widest uppercase">02 — Trayectoria</span>
      </div>
      <Timeline />
    </SectionContainer>

    <!-- Habilidades -->
    <SectionContainer id="skills" class="pt-16 lg:pt-20">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-white text-[1.7rem] lg:text-3xl font-semibold flex items-center gap-3">
          <span class="size-9 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 text-white grid place-items-center"><BladesIcon class="size-5" /></span>
          Habilidades
        </h2>
        <span class="hidden md:inline text-white/40 text-sm tracking-widest uppercase">03 — Stack</span>
      </div>
      <Skills />
    </SectionContainer>

    <!-- Proyectos -->
    <SectionContainer id="projects" class="pt-16 lg:pt-20 pb-10">
      <div class="flex items-end justify-between gap-4 mb-2">
        <h2 class="text-white text-[1.7rem] lg:text-3xl font-semibold flex items-center gap-3">
          <span class="size-9 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 text-white grid place-items-center"><CodeIcon class="size-5" /></span>
          Proyectos
        </h2>
        <span class="hidden md:inline text-white/40 text-sm tracking-widest uppercase">04 — Selección</span>
      </div>
      <p class="text-white/60 text-sm mb-6 max-w-2xl">Selección bento con enfoque editorial y carrusel inmersivo. Cada proyecto revela imágenes con navegación cinemática.</p>
      <Projects />
    </SectionContainer>
  </main>

  <script>
    const ro = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting) {
          e.target.classList.add("is-visible");
          ro.unobserve(e.target);
        }
      });
    }, { threshold:0.12, rootMargin:"0px 0px -8% 0px" });
    document.querySelectorAll(".reveal").forEach(el=> ro.observe(el));

    // GitHub avatar siempre fresco sin token - URL directa (sin rate limit) + fallback local
    (function(){
      const img = document.getElementById("gh-avatar") as HTMLImageElement | null;
      if(!img) return;
      const FALLBACK = "/images/profile-photo.webp";
      // URL directa 302 -> avatars.githubusercontent.com, siempre refleja el avatar actual
      const GH_AVATAR = "https://github.com/AnthonyEMF.png?size=460";
      // Evita flasheo si ya es fallback y la carga fue ok
      const tryLoad = (url: string, fallback: string) => {
        const test = new Image();
        test.onload = () => { img.src = url; };
        test.onerror = () => { if(img.src !== location.origin + fallback) img.src = fallback; };
        test.src = url;
      };
      // Carga fresca en segundo plano, sin token, sin API
      tryLoad(GH_AVATAR, FALLBACK);
    })();
  </script>
</Layout>
