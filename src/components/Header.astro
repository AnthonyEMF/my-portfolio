---
import NavPill from "./ui/NavPill.astro";
import HomeIcon from "../icons/Home.astro";
import SchoolIcon from "../icons/School.astro";
import CodeIcon from "../icons/Code.astro";
import BladesIcon from "../icons/Blades.astro";
import AboutUserIcon from "../icons/AboutUser.astro";
import MailIcon from "../icons/Mail.astro";
import GitHub from "../icons/social/GitHub.astro";
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[92%] max-w-3xl flex justify-center">
  <nav
    class="flex items-center gap-1 p-1.5 rounded-full bg-black/40 backdrop-blur-md supports-[backdrop-filter]:bg-white/[0.06] border border-white/10 shadow-[0_8px_32px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.08)]"
    aria-label="Navegación principal"
  >
    <a href="https://github.com/AnthonyEMF" target="_blank" rel="noopener noreferrer" class="hidden md:flex items-center justify-center size-8 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 text-white/80 hover:text-white hover:bg-white/10 hover:border-white/15 transition" aria-label="GitHub">
      <GitHub class="size-4" />
    </a>
    <div class="hidden md:block w-px h-6 bg-white/10 mx-1"></div>
    <NavPill href="#top">
      <span class="hidden sm:inline">Inicio</span>
      <HomeIcon class="size-4 sm:hidden" />
    </NavPill>
    <NavPill href="#about">
      <span class="hidden sm:inline">Sobre mí</span>
      <AboutUserIcon class="size-4 sm:hidden" />
    </NavPill>
    <NavPill href="#timeline">
      <span class="hidden sm:inline">Formación</span>
      <SchoolIcon class="size-4 sm:hidden" />
    </NavPill>
    <NavPill href="#skills">
      <span class="hidden sm:inline">Habilidades</span>
      <BladesIcon class="size-4 sm:hidden" />
    </NavPill>
    <NavPill href="#projects">
      <span class="hidden sm:inline">Proyectos</span>
      <CodeIcon class="size-4 sm:hidden" />
    </NavPill>
    <NavPill href="#contact">
      <span class="hidden sm:inline">Contáctame</span>
      <MailIcon class="size-4 sm:hidden" />
    </NavPill>
  </nav>
</header>

<script>
  const header = document.querySelector("header nav") as HTMLElement | null;
  const pills = document.querySelectorAll("header a[href^='#']") as NodeListOf<HTMLElement>;
  const pillsMap = new Map<string, HTMLElement>();
  pills.forEach(p => {
    const h = p.getAttribute('href')?.slice(1);
    if (h) pillsMap.set(h, p);
  });
  let activeId = "top";
  const setActive = (id: string) => {
    if (activeId === id) return;
    const prev = pillsMap.get(activeId);
    if (prev) prev.classList.remove("!bg-white","!text-black","shadow-md");
    const next = pillsMap.get(id);
    if(next) next.classList.add("!bg-white","!text-black","shadow-md");
    activeId = id;
  };
  // Estado inicial: Inicio activo sin query extra
  pillsMap.get("top")?.classList.add("!bg-white","!text-black","shadow-md");
  const sections = ["about","timeline","skills","projects","contact"];
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        const id = (e.target as HTMLElement).id;
        if(id) setActive(id);
      }
    });
  }, { rootMargin:"-40% 0px -55% 0px", threshold:0 });
  sections.forEach(id=>{
    const el = document.getElementById(id);
    if(el) observer.observe(el);
  });
  // Scroll unificado con rAF: maneja header blur + active top en un solo listener
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      if (header) {
        if (y > 40) {
          header.classList.add("bg-black/55", "backdrop-blur-xl");
          header.classList.remove("bg-black/40", "backdrop-blur-md");
        } else {
          header.classList.remove("bg-black/55", "backdrop-blur-xl");
          header.classList.add("bg-black/40", "backdrop-blur-md");
        }
      }
      if (y < 120) setActive("top");
      ticking = false;
    });
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  // Al hacer click en Inicio, feedback inmediato
  pillsMap.get("top")?.addEventListener("click", () => setActive("top"));
  // Cleanup para View Transitions si se reintroduce
  document.addEventListener('astro:before-swap', () => observer.disconnect());
</script>
