---
const { href, class: className, variant = "primary", "aria-label": ariaLabel } = Astro.props;
const base = "group/btn relative inline-flex items-center justify-center gap-x-2 rounded-full text-sm font-medium transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]";
const variants: Record<string,string> = {
  primary: "bg-white text-black hover:bg-white/90 shadow-lg shadow-black/20 hover:shadow-xl hover:-translate-y-0.5 px-5 py-2.5",
  glass: "bg-white/[0.06] backdrop-blur-md border border-white/10 text-white hover:bg-white/10 hover:border-white/15 hover:-translate-y-0.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] px-5 py-2.5",
  ghost: "bg-transparent border border-white/10 text-white/80 hover:text-white hover:bg-white/5 px-5 py-2.5",
};
---
<a
  href={href}
  class={`${base} ${variants[variant] || variants.primary} ${className || ""}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
>
  <span class="relative flex items-center gap-x-2">
    <slot />
  </span>
</a>
