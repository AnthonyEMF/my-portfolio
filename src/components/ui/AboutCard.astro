---
const { aboutInfo, span = "", delay = 0 } = Astro.props;
---

<div
  class={`group relative flex flex-col p-6 lg:p-7 rounded-[20px] glass hover:bg-white/[0.09] hover:border-white/15 transition-all duration-300 hover:-translate-y-1 hover:shadow-glass-lg text-left overflow-hidden reveal ${span}`}
  style={`transition-delay:${delay}ms`}
>
  <div class="absolute inset-0 bg-gradient-to-br from-white/[0.06] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition duration-500 pointer-events-none"></div>
  <div class="relative flex items-start gap-4">
    <div class="relative shrink-0">
      <div class="absolute inset-0 bg-accent-blue/15 rounded-2xl blur-xl group-hover:bg-accent-yellow/15 transition duration-500"></div>
      <div class="relative size-14 lg:size-14 rounded-2xl bg-white text-black grid place-items-center border border-white/10 group-hover:scale-[1.03] transition duration-300">
        <aboutInfo.icon class="size-7 text-black/80" />
      </div>
    </div>
    <div class="w-px self-stretch bg-white/10 hidden sm:block"></div>
    <p class="text-[0.95rem] leading-relaxed text-white/85">
      {aboutInfo.content}
    </p>
  </div>
  <div class="mt-4 h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent opacity-60"></div>
</div>
