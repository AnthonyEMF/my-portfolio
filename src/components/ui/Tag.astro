---
const { tag, featured = false } = Astro.props;
---

<li
  class={`${tag.class} flex items-center gap-2 rounded-full px-3.5 py-2 text-sm font-medium backdrop-blur-md border shadow-sm transition-all duration-300 hover:scale-[1.02] hover:shadow-md ${featured ? "scale-[1.03] shadow-lg" : ""} text-white`}
>
  <span class="size-7 rounded-full bg-white/[0.08] backdrop-blur-md border border-white/10 grid place-items-center shrink-0">
    <tag.icon class="size-4 text-white" />
  </span>
  {tag.name}
</li>
