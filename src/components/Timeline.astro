---
import { educations } from "../storage/educations";
import ThemedButton from "./ui/ThemedButton.astro";
---

<!-- Timeline unificado responsive: elimina duplicación DOM (mitad de nodos) preservando diseño exacto -->
<ol class="grid grid-cols-1 lg:grid-cols-12 gap-5">
  {educations.map((edu, i) => (
    <li class="col-span-1 lg:col-span-6 reveal" style={`transition-delay:${i*100}ms`}>
      <div class="group relative glass rounded-[18px] lg:rounded-[20px] p-5 lg:p-7 hover:bg-white/[0.08] lg:hover:bg-white/[0.08] lg:hover:border-white/15 lg:hover:-translate-y-1 lg:hover:shadow-glass-lg transition-all duration-300 flex flex-col h-full">
        <div class="absolute inset-0 bg-gradient-to-br from-white/[0.05] via-transparent to-transparent opacity-0 lg:group-hover:opacity-100 transition rounded-[18px] lg:rounded-[20px] pointer-events-none hidden lg:block"></div>
        <div class="flex items-start gap-4 lg:justify-between relative">
          <img src={edu.logo} alt={edu.title} width="64" height="64" loading={i === 0 ? "eager" : "lazy"} decoding="async" class="size-14 lg:size-16 rounded-xl lg:rounded-2xl object-cover border border-white/10 bg-white/[0.08] backdrop-blur-md p-1 shadow-sm shrink-0" />
          <div class="flex-1 min-w-0 lg:hidden">
            <div class="inline-flex px-2.5 py-1 rounded-full bg-white/[0.08] backdrop-blur-md border border-white/10 text-white text-xs font-semibold">{edu.date}</div>
            <h3 class="mt-2 text-white font-semibold leading-tight text-[15px]">{edu.title}</h3>
            <p class="text-white/60 text-sm mt-1">{edu.description}</p>
          </div>
          <span class="hidden lg:inline-flex px-3 py-1.5 rounded-full bg-white/[0.08] backdrop-blur-md border border-white/10 text-white text-xs font-bold tracking-wide shrink-0">{edu.date}</span>
        </div>
        <h3 class="hidden lg:block relative mt-5 text-white text-lg font-bold leading-tight">{edu.title}</h3>
        <p class="hidden lg:block relative text-white/60 text-sm mt-2">{edu.description}</p>
        <div class="mt-4 lg:mt-auto lg:pt-5 relative">
          {edu.link && <ThemedButton href={edu.link} variant="glass" class="lg:hidden text-xs">Ver certificado</ThemedButton>}
          {edu.link && <div class="hidden lg:block"><ThemedButton href={edu.link} variant="primary" class="!px-4 !py-2">Ver certificado</ThemedButton></div>}
        </div>
      </div>
    </li>
  ))}

  <!-- Trayectoria en curso: un solo nodo responsive (antes duplicado) -->
  <li class="col-span-1 lg:col-span-12 glass rounded-[20px] p-5 lg:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 reveal relative overflow-hidden" style="transition-delay:260ms">
    <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/[0.04] via-transparent to-transparent pointer-events-none"></div>
    <div class="flex items-start md:items-center gap-3 relative">
      <img src="/images/logos/contadito.webp" alt="Contadito" width="64" height="64" loading="lazy" decoding="async" class="size-14 lg:size-16 rounded-xl lg:rounded-2xl object-cover border border-white/10 bg-white/[0.08] backdrop-blur-md p-1 shadow-sm shrink-0" />
      <div>
        <div class="text-white font-semibold leading-tight flex flex-wrap items-center gap-2">
          <span class="relative flex size-2">
            <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full size-2 bg-emerald-400"></span>
          </span>
          Trayectoria en curso
        </div>
        <div class="text-white/60 text-sm mt-1">Pasantía como Desarrollador FullStack en <a href="https://contadito.com" target="_blank" rel="noopener noreferrer" class="text-white font-medium hover:underline underline-offset-4 decoration-white/30 hover:decoration-white">Contadito</a></div>
      </div>
    </div>
    <div class="relative w-full md:w-auto md:shrink-0 md:mr-1">
      <ThemedButton href={'https://contadito.com'} variant="glass" class="lg:hidden text-xs w-full md:w-auto justify-center">Conocer más</ThemedButton>
      <div class="hidden lg:block">
        <ThemedButton href={'https://contadito.com'} variant="primary" class="!px-5 !py-3">Conocer más</ThemedButton>
      </div>
    </div>
  </li>
</ol>
