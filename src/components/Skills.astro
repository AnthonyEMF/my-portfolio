---
import { languages, frameworks, databases, tools } from "../storage/tags";
import Tag from "./ui/Tag.astro";

const featured = new Set(["TypeScript","React",".NET Core","PostgreSQL","Docker"]);
---

<div class="grid grid-cols-12 gap-4 lg:gap-5 auto-rows-auto">
  <!-- Lenguajes - ancho -->
  <div class="col-span-12 lg:col-span-8 glass rounded-[20px] p-5 lg:p-6 reveal">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-white font-semibold flex items-center gap-2"><span class="size-2 rounded-full bg-accent-blue"></span> Lenguajes</h3>
      <span class="text-white/30 text-xs">core</span>
    </div>
    <ul class="flex flex-wrap gap-2.5">
      {Object.values(languages).map((tag) => (
        <Tag tag={tag} featured={featured.has(tag.name)} />
      ))}
    </ul>
  </div>

  <!-- DB - compacto -->
  <div class="col-span-12 lg:col-span-4 glass rounded-[20px] p-5 lg:p-6 reveal" style="transition-delay:80ms">
    <h3 class="text-white font-semibold flex items-center gap-2 mb-4"><span class="size-2 rounded-full bg-emerald-400"></span> Bases de datos</h3>
    <ul class="flex flex-wrap gap-2.5">
      {Object.values(databases).map((tag) => <Tag tag={tag} featured={featured.has(tag.name)} />)}
    </ul>
  </div>

  <!-- Frameworks - largo -->
  <div class="col-span-12 lg:col-span-7 glass rounded-[20px] p-5 lg:p-6 reveal" style="transition-delay:140ms">
    <h3 class="text-white font-semibold flex items-center gap-2 mb-4"><span class="size-2 rounded-full bg-accent-yellow"></span> Frameworks & Librerías</h3>
    <ul class="flex flex-wrap gap-2.5">
      {Object.values(frameworks).map((tag) => <Tag tag={tag} featured={featured.has(tag.name)} />)}
    </ul>
  </div>

  <!-- Tools - muro -->
  <div class="col-span-12 lg:col-span-5 glass rounded-[20px] p-5 lg:p-6 reveal" style="transition-delay:190ms">
    <h3 class="text-white font-semibold flex items-center gap-2 mb-4"><span class="size-2 rounded-full bg-white/60"></span> Otras herramientas</h3>
    <ul class="flex flex-wrap gap-2.5">
      {Object.values(tools).map((tag) => <Tag tag={tag} />)}
    </ul>
  </div>
</div>
