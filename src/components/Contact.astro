---
import { ContactForm } from "./react/ContactForm";
import MailIcon from "../icons/Mail.astro";
import Gmail from "../icons/social/Gmail.astro";
import LinkedIn from "../icons/social/LinkedIn.astro";
import WhatsApp from "../icons/social/WhatsApp.astro";
import GitHub from "../icons/social/GitHub.astro";
---

<div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-6 lg:gap-7 items-start">
  <!-- Columna izquierda: info -->
  <div class="relative glass rounded-[20px] p-6 lg:p-7 overflow-hidden reveal flex flex-col gap-6" style="transition-delay:0ms">
    <div class="absolute -inset-1 bg-gradient-to-br from-accent-blue/10 via-transparent to-accent-yellow/10 blur-2xl opacity-60 pointer-events-none"></div>
    <div class="relative">
      <div class="inline-flex items-center gap-2 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 px-3 py-1 text-xs text-white/70">
        <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Respuesta en &lt; 24 horas
      </div>
      <h3 class="mt-4 text-white text-xl lg:text-2xl font-bold leading-tight">Hagamos realidad tu idea</h3>
      <p class="mt-3 text-white/65 text-sm leading-relaxed">
        ¿Tienes un proyecto, una idea o quieres colaborar? Cuéntame qué necesitas y te propongo la mejor solución técnica.
      </p>
    </div>

    <div class="relative flex flex-col gap-3">
      <a
        href="mailto:anthony07miranda@gmail.com"
        class="group flex items-center gap-3 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 hover:bg-white/[0.08] hover:border-white/15 p-3.5 transition"
      >
        <span class="size-10 rounded-xl bg-white/[0.08] border border-white/10 grid place-items-center text-white shrink-0 group-hover:scale-[1.03] transition">
          <Gmail class="size-5" />
        </span>
        <span class="min-w-0">
          <span class="block text-xs text-white/50">Escríbeme directo</span>
          <span class="block text-sm font-medium text-white truncate">anthony07miranda@gmail.com</span>
        </span>
        <span class="ml-auto size-7 rounded-full bg-white/[0.06] border border-white/10 grid place-items-center text-white/60 group-hover:text-white group-hover:translate-x-0.5 transition">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="rounded-xl bg-white/[0.04] backdrop-blur-md border border-white/10 p-3.5 flex items-center gap-3">
          <span class="size-9 rounded-lg bg-white/[0.06] border border-white/10 grid place-items-center text-white/80 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-white">Freelance & Contratos</span>
            <span class="block text-xs text-emerald-300/80">● Disponible ahora</span>
          </span>
        </div>
        <div class="rounded-xl bg-white/[0.04] backdrop-blur-md border border-white/10 p-3.5 flex items-center gap-3">
          <span class="size-9 rounded-lg bg-white/[0.06] border border-white/10 grid place-items-center text-white/80 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-white leading-tight">Honduras</span>
            <span class="block text-xs text-white/40">Remoto disponible</span>
          </span>
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent mb-5"></div>
      <p class="text-xs font-medium tracking-widest uppercase text-white/30 mb-3">También en</p>
      <div class="flex flex-wrap gap-2">
        <a href="https://wa.me/50497354899" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/10 hover:border-white/15 transition">
          <WhatsApp class="size-4" /> WhatsApp
        </a>
        <a href="https://www.linkedin.com/in/anthony-miranda-8a140b362/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-white/[0.06] backdrop-blur-md border border-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/10 hover:border-white/15 transition">
          <LinkedIn class="size-4" /> LinkedIn
        </a>
      </div>
    </div>
  </div>

  <!-- Columna derecha: formulario -->
  <div class="relative glass rounded-[20px] p-6 lg:p-7 overflow-hidden reveal shadow-glass-lg border border-white/10" style="transition-delay:110ms">
    <div class="absolute inset-0 bg-gradient-to-br from-white/[0.04] via-transparent to-transparent pointer-events-none"></div>
    <div class="relative">
      <div class="flex items-center gap-3 mb-1">
        <span class="size-9 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 grid place-items-center text-white">
          <MailIcon class="size-5" />
        </span>
        <div>
          <h3 class="text-white font-semibold leading-tight">Envíame un mensaje</h3>
          <p class="text-xs text-white/50">Todos los campos marcados con <span class="text-accent-yellow">*</span> son requeridos</p>
        </div>
      </div>
      <div class="h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent my-5"></div>
      <ContactForm client:visible />
    </div>
  </div>
</div>
