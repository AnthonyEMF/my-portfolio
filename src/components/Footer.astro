---
import Gmail from "../icons/social/Gmail.astro";
import LinkedIn from "../icons/social/LinkedIn.astro";
import ThemedButton from "./ui/ThemedButton.astro";
---

<footer class="mt-16 border-t border-white/10 bg-black/30 backdrop-blur-md">
  <div class="w-full max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-10 flex flex-col lg:flex-row items-center justify-between gap-6">
    <div class="flex flex-col sm:flex-row items-center gap-3 text-sm text-white/70">
      <span class="size-8 rounded-full bg-gradient-to-br from-accent-blue to-accent-yellow grid place-items-center text-black font-bold text-xs">AM</span>
      <span>
        Desarrollado por <a target="_blank" rel="noopener noreferrer" href="https://github.com/AnthonyEMF" class="text-white hover:underline underline-offset-4">@AnthonyEMF</a>
        <span aria-hidden="true" class="mx-1 opacity-40">&lt;/&gt;</span> 2025
      </span>
    </div>
    <nav class="flex gap-2 flex-wrap justify-center">
      <ThemedButton href="https://www.linkedin.com/in/anthony-miranda-8a140b362/" variant="glass">
        <LinkedIn class="size-4" /> LinkedIn
      </ThemedButton>
      <ThemedButton href="mailto:anthony07miranda@gmail.com" variant="glass">
        <Gmail class="size-4" /> anthony07miranda@gmail.com
      </ThemedButton>
    </nav>
  </div>
  <div class="h-1 w-full bg-gradient-to-r from-accent-blue via-accent-blue/50 to-accent-yellow opacity-60"></div>
</footer>
