---
import "../styles/global.css"; /* Importe de los estilos con Tailwind */
import "@fontsource-variable/inter"; /* Inter Variable - body */
import "@fontsource-variable/space-grotesk"; /* Space Grotesk Variable - display */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Anthony Miranda | Desarrollador Web y Mobile Full Stack</title>
        <meta
            name="description"
            content="Desarrollador web y mobile. Creo soluciones digitales a medida con tecnologías modernas. Mira mis proyectos y contáctame para tu próximo desarrollo."
        />
        <ClientRouter />
        <!-- Estilos globales -->
        <style is:global>
            :root {
                color-scheme: dark;
            }
            html {
                font-family: var(--font-body);
                scroll-behavior: smooth;
                scroll-padding-top: 88px;
            }
            h1,h2,h3 {
                font-family: var(--font-display);
                letter-spacing: -0.02em;
            }
            body {
                background: #050505;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* --- Propiedades animables del gradiente --- */
            @property --gx {
                syntax: "<percentage>";
                inherits: false;
                initial-value: 55%;
            }
            @property --gy {
                syntax: "<percentage>";
                inherits: false;
                initial-value: 12%;
            }
            @property --bx {
                syntax: "<percentage>";
                inherits: false;
                initial-value: 30%;
            }
            @property --by {
                syntax: "<percentage>";
                inherits: false;
                initial-value: 85%;
            }

            /* --- Background amarillo-azul suave --- */
            .bg-animated {
                background:
                    radial-gradient(110% 90% at var(--gx) var(--gy), color-mix(in oklab, var(--color-accent-blue) 22%, transparent) 0%, transparent 55%),
                    radial-gradient(90% 80% at var(--bx) var(--by), color-mix(in oklab, var(--color-accent-yellow) 16%, transparent) 0%, transparent 55%),
                    radial-gradient(125% 125% at 50% 0%, color-mix(in oklab, var(--color-accent-blue-strong) 10%, transparent) 0%, transparent 40%),
                    #050505;
                animation: bgMove 12s ease-in-out infinite;
            }
            .bg-animated::after {
                content:"";
                position:absolute;
                inset:0;
                background: radial-gradient(60% 50% at 50% 100%, rgba(255,255,255,0.04), transparent 60%);
                pointer-events:none;
            }

            @keyframes bgMove {
                0%   { --gx: 55%; --gy: 12%; --bx: 30%; --by: 85%; }
                25%  { --gx: 70%; --gy: 18%; --bx: 22%; --by: 78%; }
                50%  { --gx: 60%; --gy: 8%;  --bx: 38%; --by: 88%; }
                75%  { --gx: 40%; --gy: 16%; --bx: 32%; --by: 80%; }
                100% { --gx: 55%; --gy: 12%; --bx: 30%; --by: 85%; }
            }

            @media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }
                .bg-animated {
                    animation: none;
                }
            }
        </style>
    </head>
    <body>
        <!-- Background -->
        <div class="bg-animated fixed inset-0 -z-10 h-full w-full"></div>
        <!-- Encabezado -->
        <Header />
        <!-- Contenido de la página -->
        <slot />
        <!-- Pie de página -->
        <Footer />
    </body>
</html>
